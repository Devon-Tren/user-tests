{
  "name": "user-tests",
  "version": "0.1.0",
  "description": "A council of LLM-driven agent personas that user-test a locally running web app and produce a single REPORT.md.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "dashboard",
    "personas",
    "council.config.yaml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "usertests": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:dashboard",
    "test:unit": "tsx --test tests/acceptance.test.ts tests/artifacts.test.ts tests/config.test.ts tests/llm.test.ts tests/report.test.ts tests/server.test.ts",
    "test:dashboard": "tsx --test tests/dashboard.test.ts tests/runner.test.ts",
    "check": "npm test",
    "smoke": "tsx scripts/smoke.ts",
    "acceptance": "npm run build && tsx scripts/acceptance.ts",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "fixture:serve": "node scripts/serve-fixture.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "three": "^0.186.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "author": "Devon Trenoskie"
}
